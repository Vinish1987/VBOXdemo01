// ============================================================================
//  VBOX data model
//  Plain-language tour (top to bottom):
//   - User ............ an account (viewer, creator, or admin)
//   - Plan / Subscription  the paid tiers and who's currently subscribed
//   - CreditPack / CreditLedger  the VBOX Credits wallet (à-la-carte unlocks)
//   - Series / Season / Episode  the catalog you watch
//   - Entitlement ..... a durable "this user may watch this episode" record
//   - Ad / AdImpression  the advertising system (revenue on the free tier)
//   - WatchProgress ... resume-where-you-left-off
//   - Payment ......... every money movement (subscriptions + credit packs)
// ============================================================================

generator client {
  provider = "prisma-client-js"
  // "native" = your own computer. "rhel-openssl-3.0.x" = the servers Vercel
  // runs on. Listing both means the app works locally AND when deployed.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────── People ───────────────────────────

enum UserRole {
  VIEWER
  CREATOR
  ADMIN
}

// Where someone is in the "become a creator" pipeline. Being a CREATOR by role
// is not enough to upload — they must also be APPROVED here.
enum CreatorStatus {
  NONE // hasn't applied
  PENDING // applied, waiting on admin
  APPROVED // can upload
  REJECTED // declined
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         UserRole @default(VIEWER)

  // Email verification (sending is wired in a later phase; the fields exist now).
  emailVerified DateTime?

  // Creator pipeline. A user only gains upload powers once this is APPROVED.
  creatorStatus CreatorStatus @default(NONE)

  // Cached wallet balance. The CreditLedger rows are the source of truth;
  // this column is kept in sync for fast reads at the paywall.
  creditsBalance Int @default(0)

  createdAt DateTime @default(now())

  subscriptions       Subscription[]
  entitlements        Entitlement[]
  creditLedger        CreditLedger[]
  watchProgress       WatchProgress[]
  payments            Payment[]
  adImpressions       AdImpression[]
  createdSeries       Series[]              @relation("SeriesCreator")
  creatorApplication  CreatorApplication?   @relation("ApplicantUser")
  reviewedApplications CreatorApplication[] @relation("ApplicationReviewer")
  verificationTokens  VerificationToken[]

  @@index([role])
  @@index([creatorStatus])
}

// A viewer's request to become a creator, and the admin's decision on it.
model CreatorApplication {
  id          String        @id @default(cuid())
  userId      String        @unique
  channelName String
  pitch       String        @default("")
  status      CreatorStatus @default(PENDING)
  reviewedById String?
  reviewNote  String?
  createdAt   DateTime      @default(now())
  reviewedAt  DateTime?

  user       User  @relation("ApplicantUser", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("ApplicationReviewer", fields: [reviewedById], references: [id])

  @@index([status])
}

// One-time tokens for email verification and password reset.
enum TokenPurpose {
  EMAIL_VERIFY
  PASSWORD_RESET
}

model VerificationToken {
  id        String       @id @default(cuid())
  userId    String
  token     String       @unique
  purpose   TokenPurpose
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
}

// ─────────────────────── Subscriptions (SVOD) ───────────────────────

enum PlanInterval {
  NONE // the free plan
  MONTH
  YEAR
}

model Plan {
  id       String       @id @default(cuid())
  code     String       @unique // FREE | PREMIUM_MONTHLY | PREMIUM_ANNUAL
  name     String
  price    Int // in paise (₹299 => 29900). 0 for the free plan.
  interval PlanInterval @default(NONE)

  // What this plan grants:
  adFree           Boolean @default(false) // Premium removes ads
  grantsAllEpisodes Boolean @default(false) // Premium unlocks the whole catalog
  maxQuality       String  @default("720p") // 480p | 720p | 1080p | 4K

  active Boolean @default(true)

  subscriptions Subscription[]
}

enum SubStatus {
  ACTIVE
  CANCELED // will not renew, still valid until period end
  EXPIRED
  TRIALING
}

model Subscription {
  id     String    @id @default(cuid())
  userId String
  planId String
  status SubStatus @default(ACTIVE)

  currentPeriodStart DateTime @default(now())
  currentPeriodEnd   DateTime // access is valid until here
  cancelAtPeriodEnd  Boolean  @default(false)

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan Plan @relation(fields: [planId], references: [id])

  @@index([userId, status])
}

// ─────────────────────── Credits wallet (TVOD) ───────────────────────

model CreditPack {
  id     String  @id @default(cuid())
  code   String  @unique
  credits Int
  bonus   Int    @default(0)
  price   Int // in paise
  active  Boolean @default(true)
}

model CreditLedger {
  id           String   @id @default(cuid())
  userId       String
  delta        Int // +330 on recharge, -30 on unlock
  reason       String
  balanceAfter Int
  refType      String? // "PAYMENT" | "UNLOCK" | "SEASON_PASS" | "PROMO"
  refId        String?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// ─────────────────────────── Catalog ───────────────────────────

enum EpisodeStatus {
  DRAFT
  PROCESSING // transcoding in progress
  IN_REVIEW
  PUBLISHED
}

model Series {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  synopsis  String
  genre     String
  tags      String[]
  heroColor String   @default("rose") // drives the placeholder artwork
  rating    Float    @default(0)
  published Boolean  @default(true)

  creatorId String?
  creator   User?   @relation("SeriesCreator", fields: [creatorId], references: [id])

  createdAt DateTime @default(now())

  seasons  Season[]
  episodes Episode[]

  @@index([published])
}

model Season {
  id       String @id @default(cuid())
  seriesId String
  number   Int
  title    String

  series   Series    @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  episodes Episode[]

  @@unique([seriesId, number])
}

model Episode {
  id       String @id @default(cuid())
  seriesId String
  seasonId String?
  number   Int
  title    String
  synopsis String @default("")

  durationSec Int @default(90)

  // Monetization flags:
  isFree        Boolean @default(false) // free tier can watch (with ads). Usually EP 1.
  unlockCredits Int     @default(30) // à-la-carte price in VBOX Credits

  // Where the actual video lives (private bucket). Never served directly.
  videoKey     String?
  thumbnailKey String?

  status EpisodeStatus @default(PUBLISHED)

  createdAt DateTime @default(now())

  series        Series          @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  season        Season?         @relation(fields: [seasonId], references: [id])
  entitlements  Entitlement[]
  watchProgress WatchProgress[]
  adImpressions AdImpression[]

  @@unique([seriesId, number])
  @@index([status])
}

// ─────────────────────── Entitlements (the paywall's memory) ───────────────────────

enum EntitlementSource {
  FREE_EPISODE
  SUBSCRIPTION
  CREDIT_UNLOCK
  SEASON_PASS
  PROMO
}

// A durable "this user may watch this episode forever" record, created when
// they unlock à-la-carte or buy a season pass. (Subscription access is decided
// live from the Subscription table, so it doesn't create rows here.)
model Entitlement {
  id        String            @id @default(cuid())
  userId    String
  episodeId String
  source    EntitlementSource
  grantedAt DateTime          @default(now())
  expiresAt DateTime? // null = forever

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  episode Episode @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@unique([userId, episodeId])
  @@index([userId])
}

// ─────────────────────────── Advertising ───────────────────────────

enum AdType {
  PRE_ROLL
  MID_ROLL
  POST_ROLL
}

model Ad {
  id         String  @id @default(cuid())
  title      String
  advertiser String
  mediaUrl   String
  clickUrl   String
  durationSec Int    @default(15)
  type       AdType  @default(PRE_ROLL)
  weight     Int     @default(1) // higher = shown more often
  // Rough revenue per completed view, in micro-rupees (₹1 = 1_000_000).
  // Lets us estimate ad revenue without a real ad exchange yet.
  cpmMicros  Int     @default(120000)
  active     Boolean @default(true)

  impressions AdImpression[]

  @@index([active, type])
}

model AdImpression {
  id        String   @id @default(cuid())
  adId      String
  userId    String?
  episodeId String?
  position  AdType
  completed Boolean  @default(false)
  servedAt  DateTime @default(now())

  ad      Ad       @relation(fields: [adId], references: [id], onDelete: Cascade)
  user    User?    @relation(fields: [userId], references: [id])
  episode Episode? @relation(fields: [episodeId], references: [id])

  @@index([userId, servedAt])
  @@index([adId, servedAt])
}

// ─────────────────────── Playback + Money ───────────────────────

model WatchProgress {
  id          String   @id @default(cuid())
  userId      String
  episodeId   String
  positionSec Int      @default(0)
  completed   Boolean  @default(false)
  updatedAt   DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  episode Episode @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@unique([userId, episodeId])
}

enum PaymentKind {
  SUBSCRIPTION
  CREDIT_PACK
}

enum PaymentStatus {
  CREATED
  PAID
  FAILED
  REFUNDED
}

model Payment {
  id       String        @id @default(cuid())
  userId   String
  kind     PaymentKind
  amount   Int // in paise
  currency String        @default("INR")
  provider String        @default("MOCK") // RAZORPAY later
  providerOrderId   String?
  providerPaymentId String?
  status   PaymentStatus @default(CREATED)
  meta     Json? // e.g. { planCode } or { packCode }
  createdAt DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}
